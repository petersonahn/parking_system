// 검색 관련 멤버 선언
	private String field;
	private String keyword;

		
	// 검색을 하는 페이징 처리 인자 생성자
	public Page(int page, int rowsize, int totalRecord,
				String field, String keyword) {
		
		this(page, rowsize, totalRecord);
		this.field = field;
		this.keyword = keyword;
		
	}  // 인자 생성자
	
	



