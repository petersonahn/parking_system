// parking.xml 추가


<select id="scount" parameterType="map" resultType="int">
  SELECT COUNT(*) FROM parking_record
  <where>
    <choose>
      <when test="field =='in_time'">
        TO_CHAR(in_time, 'YYYY-MM-DD') = #{keyword}
      </when>
      <when test="field == 'car_num'">
        car_num LIKE '%' || #{keyword} || '%'
      </when>
      <when test="field =='parking'">
        out_time IS NULL
      </when>
    </choose>
  </where>
</select>



	
<select id="carlist_search" parameterType="page" resultType="Parking_record">
  SELECT * FROM (
    SELECT ROW_NUMBER() OVER (ORDER BY parking_rec_num DESC) rnum, a.*
    FROM parking_record a
    <where>
      <choose>
        <when test="field == 'in_time'">
          TO_CHAR(in_time, 'YYYY-MM-DD') = #{keyword}
        </when>
        <when test="field == 'car_num'">
          car_num LIKE '%' || #{keyword} || '%'
        </when>
        <when test="field == 'parking'">
          out_time IS NULL
        </when>
      </choose>
    </where>
  )
  WHERE rnum BETWEEN #{startNo} AND #{endNo}
</select>








