# parking.xml

<select id="getFee" resultType="ParkingFeeDTO">
    select * from parking_fee
</select>

<update id="updateFee" parameterType="ParkingFeeDTO">
    update parking_fee set
        base_fee = #{base_fee},
        base_minutes = #{base_minutes},
        hourly_fee = #{hourly_fee},
        unit_minutes = #{unit_minutes},
        max_fee_per_day = #{max_fee_per_day}
</update>



# ParkingFeeDTO

package com.boot.parking.model;

import lombok.Data;

@Data
public class ParkingFeeDTO {
