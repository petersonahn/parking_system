// PakingFeeDTO 복사 붙여넣기

package com.boot.parking.model;

import java.util.Date;
import lombok.Data;

@Data
public class ParkingFeeDTO {
    private int base_fee;             // 기본요금
    private int base_minutes;         // 기본요금 적용 시간
    private int hourly_fee;           // 시간당 요금
    private int unit_minutes;         // 요금 부과 단위
    private int max_fee_per_day;	  // 일 최대 요금
}



____________________________________________________________________________________________________


// 컨트롤러 클래스에 해당 부분만 복사 붙여넣기

	@PostMapping("went_out_ok.go")
	public void went_out_ok(@RequestParam("car_num") String car_num,
	                        HttpServletResponse response) throws IOException {
		
		ParkingFeeDTO dfee = this.mapper.selectParkingFee(); 
		ParkingFeeDTO feeDTO = new ParkingFeeDTO();
		
		feeDTO.setBase_fee(dfee.getBase_fee());
		feeDTO.setBase_minutes(dfee.getBase_minutes());
		feeDTO.setHourly_fee(dfee.getHourly_fee());
		feeDTO.setUnit_minutes(dfee.getUnit_minutes());
		feeDTO.setMax_fee_per_day(dfee.getMax_fee_per_day());
		
		int baseMinutes = feeDTO.getBase_minutes();
		int baseFee = feeDTO.getBase_fee();
		int hourlyFee = feeDTO.getHourly_fee();
		int unitMinutes = feeDTO.getUnit_minutes();
		int maxFeePerDay = feeDTO.getMax_fee_per_day();

	    response.setContentType("text/html; charset=UTF-8");
	    PrintWriter out = response.getWriter();

	    Date inTime = mapper.selectInTimeByCarNum(car_num);

	    if (inTime == null) {
	        out.println("<script>");
	        out.println("alert('입차 기록이 없습니다.');");
	        out.println("history.back();");
	        out.println("</script>");
	        return;
	    }

	    Date outTime = new Date();

	    long millis = outTime.getTime() - inTime.getTime();
	    long minutes = millis / (1000 * 60);

	    int fee = 0;
	    
	    if (minutes > 1440) {
	        fee = (int) (Math.floor((double) (minutes / 1440))) * maxFeePerDay;
	    }else {
	    	if (minutes > unitMinutes) {
	    		fee = (int) (Math.floor((double) ((minutes - baseMinutes) / unitMinutes))) * hourlyFee;
	    		
	    	}else {
	    		fee = baseFee;
	    	}
	    	
	    }

	    // parking_record 조회해서 PK 가져오기 (별도 메서드 필요)
	    int parkingRecNum = mapper.selectRecordNumByCarNumAndInTime(car_num, inTime);
	    if (parkingRecNum == 0) {
	        out.println("<script>");
	        out.println("alert('주차 기록이 없습니다.');");
	        out.println("history.back();");
	        out.println("</script>");
	        return;
	    }

	    ParkingRecordDTO record = new ParkingRecordDTO();
	    record.setParking_rec_num(parkingRecNum);
	    record.setCar_num(car_num);
	    record.setIn_time(inTime);
	    record.setOut_time(outTime);
	    record.setFee_amount(fee);

	    int updateCount = mapper.record_out(record);

	    if (updateCount > 0) {
	        int delParking = mapper.out(car_num);           // parking 테이블 car_num null 처리

	        if (delParking > 0) {
	            out.println("<script>");
	            out.println("alert('출차 완료. 요금: " + fee + "원');");
	            out.println("location.href='/'");
	            out.println("</script>");
	        } else {
	            out.println("<script>");
	            out.println("alert('출차 처리 오류');");
	            out.println("history.back();");
	            out.println("</script>");
	        }
	    } else {
	        out.println("<script>");
	        out.println("alert('주차 기록 업데이트 실패');");
	        out.println("history.back();");
	        out.println("</script>");
	    }
	}
