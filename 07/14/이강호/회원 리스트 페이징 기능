  // ManagementController 해당 부분 복사 붙여넣기

  @GetMapping("user_management.go")
	public String userManage(@RequestParam(value = "page", defaultValue = "1") int page, Model model) {
		
		totalRecord = this.mapper.ucount();
		
		Page pdto = new Page(page, rowsize, totalRecord);
		
		List<UsersDTO> userList = this.mapper.userList(pdto);
		
		model.addAttribute("userList", userList)
		     .addAttribute("paging", pdto);
		
		return "parking_management/user_management";
	}


  ________________________________________________________________________________________________________________

  // parking.xml 해당 부분 복사 붙여넣기(기존의 userList 대체)


  <select id="userList" parameterType="page" resultType="Users">
	<![CDATA[
  			select * from
				(select row_number()
					over(order by user_id) rnum, u.* from users u)
						where rnum >= #{startNo} and rnum <= #{endNo}
  		]]>
	</select>

********************************************(새로운 sql문 추가)**************************
 <select id="ucount" resultType="int">
		select count(*) from users
	</select>



