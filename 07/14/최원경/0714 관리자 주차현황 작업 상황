commit;



///    parking.xml 쿼리문 수정 , 추가

<insert id="record_in" parameterType="Record" useGeneratedKeys="false">
        <selectKey keyProperty="parking_rec_num" resultType="java.lang.Integer" order="BEFORE">
	        SELECT seq_parking_record.NEXTVAL FROM dual
	    </selectKey>
	    
	    insert into parking_record(parking_rec_num, car_num, parking_id, in_time, out_time, user_id, fee_amount)
	    values(#{parking_rec_num}, #{car_num}, #{parking_id, jdbcType=VARCHAR}, #{in_time, jdbcType=TIMESTAMP}, null, #{user_id}, 0)
    </insert>

 

<select id="getRecordsByCarNum" parameterType="String" resultType="Record">
   						 SELECT parking_rec_num, car_num, parking_id, in_time, out_time, user_id, fee_amount
   						 FROM parking_record WHERE car_num = #{carNum} ORDER BY in_time DESC
	</select>


