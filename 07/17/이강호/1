<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>주차 정보</title>
    <style>
        body {
            background-color: #f6f9fc;
            font-family: 'Segoe UI', '맑은 고딕', sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 700px;
            margin: 60px auto;
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            padding: 30px;
        }

        h2 {
            text-align: center;
            color: #2d6ac0;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: separate;
    		border-spacing: 0;
            border-radius: 12px;
        }

        th, td {
            border: 1px solid #dee2e6;
            padding: 14px;
            text-align: center;
            font-size: 16px;
        }

        th {
            background-color: #3498db;
            color: #fff;
            font-weight: 600;
        }

        tr:nth-child(even) td {
            background-color: #f9f9f9;
        }

        .submit-btn {
            display: block;
            margin: 30px auto 0 auto;
            padding: 14px 32px;
            font-size: 16px;
            background-color: #2d6ac0;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.25s ease;
        }

        .submit-btn:hover {
            background-color: #1c4f99;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>주차 정보 확인</h2>
        <form method="post" action="<%=request.getContextPath() %>/parking_out_ok.go">
        
	    <input type="hidden" name="car_num" value="${record.car_num}" />
	    <input type="hidden" name="fee_amount" value="${record.fee_amount}" />
            <table>
                <tr>
                    <th>차량 번호</th>
                    <th>입차 시간</th>
                    <th>주차한 시간</th>
                    <th>요금</th>
                </tr>
                <tr>
                    <td>${record.car_num}</td>
                    <td><fmt:formatDate value="${record.in_time}" pattern="yyyy-MM-dd HH:mm" /></td>
                    <td>${stayDuration}</td>
                    <td><fmt:formatNumber value="${record.fee_amount}" pattern="#,##0" /> 원</td>
                </tr>
            </table>
            <input type="submit" class="submit-btn" value="결제하기">
        </form>
    </div>

</body>
</html>



