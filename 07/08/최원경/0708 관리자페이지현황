package com.boot.parking.model;

import lombok.Data;

@Data
public class ManagerDTO {

	private String manager_id;
	private String manager_pwd;
	
	
}


                  // ParkingMapper.java 에 코드 추가 

public interface ParkingMapper {

	List<ParkingDTO> pList();
	
	String search_car(String car_num);
	
	int out_time_update(String car_num);
	
	int out(String car_num);
	
	ManagerDTO login(ManagerDTO dto);  -- 새로 추가된 코드 
}

                // mybatis-config.xml 에 코드 추가 
  

<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>

	<typeAliases>
		<typeAlias type="com.boot.parking.model.CarsDTO" alias="cars" />
		<typeAlias type="com.boot.parking.model.ParkingDTO" alias="parking" />
		<typeAlias type="com.boot.parking.model.ManagerDTO" alias="manager"/>  -- 새로 추가된 코드 
	</typeAliases>
	
</configuration>

                //parking.xml에 코드 추가 

<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.boot.parking.model.ParkingMapper">

	<select id="pList" resultType="parking">
		select * from parking order by parking_id
	</select>
	
	<select id="search_car" resultType="String" parameterType="String">
		select parking_id from parking where car_num = #{car_num}
	</select>
	
	<update id="out_time_update" parameterType="String">
		update cars set out_time = sysdate where car_num = #{car_num}
	</update>
	
	<delete id="out" parameterType="String">
		delete from cars where car_num = #{car_num}
	</delete>
	
	<select id="login" parameterType="manager" resultType="manager">               ---- 새로 추가된 코드 
		select * from managers
		where manager_id = #{manager_id} and manager_pwd = #{manager_pwd}
	</select>                                                                      ---- 새로 추가된 코드 

</mapper>
