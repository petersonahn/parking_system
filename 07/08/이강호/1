<select id="car_list" parameterType="page" resultType="Parking_record">
  		<![CDATA[
  	
			select * from
				(select row_number()
					over(order by parking_rec_num desc) rnum, b.* from parking_record b)
						where rnum >= #{startNo} and rnum <= #{endNo}
  		]]>
	</select>

		
	<select id="count" resultType="int">
		select count(*) from parking_record
	</select>



