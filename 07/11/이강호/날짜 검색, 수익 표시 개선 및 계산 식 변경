// parking.xml 해당 부분 복사 붙여넣기

<select id="scount" parameterType="map" resultType="int">
		SELECT COUNT(*) FROM parking_record
	  	<where>
	    	<choose>
	      		<when test="field == 'in_time' or field eq 'in_time'">
  				TO_CHAR(in_time, 'YYYY-MM-DD') LIKE #{keyword} || '%'
				</when>
	      		
	      		<when test="field == 'car_num'">
	        		car_num LIKE '%' || #{keyword} || '%'
	      		</when>
	      		
	      		<when test="field eq 'out_time' and keyword eq '주차중'">
		          out_time IS NULL
		        </when>
		
		        <when test="field eq 'out_time'">
		          TO_CHAR(out_time, 'YYYY-MM-DD') LIKE #{keyword} || '%'
		        </when>
	    	</choose>
	  	</where>
	</select>
	
	<select id="carlist_search" parameterType="page" resultType="Record">
  SELECT * FROM (
    SELECT ROW_NUMBER() OVER (ORDER BY in_time DESC) rnum, a.*
    FROM parking_record a
    <where>
      <choose>

        <when test="(field eq 'in_time')">
          TO_CHAR(in_time, 'YYYY-MM-DD') LIKE #{keyword} || '%'
        </when>

        <when test="field eq 'car_num'">
          car_num LIKE '%' || #{keyword} || '%'
        </when>

        <when test="field eq 'out_time' and keyword eq '주차중'">
          out_time IS NULL
        </when>

        <when test="field eq 'out_time'">
          TO_CHAR(out_time, 'YYYY-MM-DD') LIKE #{keyword} || '%'
        </when>

      </choose>
    </where>
  )
  WHERE rnum BETWEEN #{startNo} AND #{endNo}
</select>

	
	<select id="amountfee" resultType="Integer">
  SELECT SUM(fee_amount)
  FROM parking_record
 </select>
  
  
	<select id="searchamountfee" parameterType="map" resultType="Integer">
  SELECT SUM(fee_amount)
  FROM parking_record
  <where>
    <choose>
      <!-- in_time 검색 시 -->
      <when test="field == 'in_time'">
        out_time IS NOT NULL
        AND TO_CHAR(in_time, 'YYYY-MM-DD') LIKE #{keyword} || '%'
      </when>

      <!-- car_num 검색 시 -->
      <when test="field == 'car_num'">
        out_time IS NOT NULL
        AND car_num LIKE '%' || #{keyword} || '%'
      </when>

      <!-- out_time 검색 시: out_time이 NULL인 행도 포함 가능 -->
      <when test="field == 'out_time'">
        TO_CHAR(out_time, 'YYYY-MM-DD') LIKE #{keyword} || '%'
      </when>
    </choose>
  </where>
</select>


